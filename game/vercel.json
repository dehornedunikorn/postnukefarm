{
  "buildCommand": "bash scripts/build_web.sh",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*)\\.pck",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}