{
  "buildCommand": "bash game/scripts/build_web.sh",
  "outputDirectory": "game/build/web",
  "installCommand": "npm install --ignore-scripts",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*)\\.pck",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}